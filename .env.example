# Verso Server Configuration Example
# Copy to .env and configure for your local environment.
# Verso is a private, single-user localhost service. Do not commit operational secrets.

# ==============================================================================
# Database & Storage
# ==============================================================================
# PostgreSQL connection string with pgvector extension enabled.
VERSO_DATABASE_URL=postgres://verso:verso_dev_secret@127.0.0.1:5432/verso

# Local content-addressed asset storage directory (outside web root)
VERSO_DATA_DIR=./data

# ==============================================================================
# Network Binding & Security
# ==============================================================================
# Web server host binding. In default single-user profile, must be a loopback
# address (127.0.0.1, localhost, ::1) to prevent accidental LAN exposure.
VERSO_HOST=127.0.0.1
VERSO_PORT=4173

# Optional: set to true only if remote access authentication is configured (future)
# VERSO_ALLOW_REMOTE=false

# Optional: comma-separated list of allowed origins for state-changing requests
# VERSO_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# ==============================================================================
# OpenAI-Compatible Model Endpoint Configuration (Server-side only)
# ==============================================================================
# The single endpoint used for reasoning, fast classification, embeddings, and media.
VERSO_OPENAI_BASE_URL=https://api.openai.com/v1
VERSO_OPENAI_API_KEY=

# Model identifiers configured behind the single endpoint
VERSO_REASONING_MODEL=gpt-4o
VERSO_FAST_MODEL=gpt-4o-mini
VERSO_MEDIA_MODEL=gpt-4o
VERSO_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# Internationalization & Defaults
# ==============================================================================
# Supported interface locales: zh-CN, en-US
VERSO_DEFAULT_LOCALE=zh-CN

# ==============================================================================
# Resource Limits & Safety Reserves
# ==============================================================================
VERSO_CONTEXT_BUDGET=128000
VERSO_MAX_OUTPUT_TOKENS=4096
VERSO_REQUEST_TIMEOUT_MS=60000
VERSO_MAX_UPLOAD_BYTES=104857600

