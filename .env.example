# ==============================================================================
# Verso v1.0.0 — 严肃文学创作与审读工作台服务端环境配置
# ==============================================================================
# Verso 为私有单用户本机服务。模型密钥由服务端统一受控，绝不流向浏览器前端。
# 请填写您所选择的模型服务商 API Key 及相关模型配置后启动服务。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 数据库与本地媒体存储
# ------------------------------------------------------------------------------
# PostgreSQL 数据库连接串（需启用 pgvector 扩展）
# - 本地直接运行 (npm start / npm run dev) 默认连接 127.0.0.1:5432:
VERSO_DATABASE_URL=postgres://verso:verso_dev_secret@127.0.0.1:5432/verso

# - Docker Compose 容器内运行时，Compose 会自动覆盖为容器内网络地址:
#   postgres://verso:verso_dev_secret@postgres:5432/verso

# 本地内容寻址多媒体素材存储目录（独立于 Web 根目录）
VERSO_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. 网络监听与安全边界
# ------------------------------------------------------------------------------
# 单用户模式下默认仅允许绑定回环地址 (127.0.0.1, localhost, ::1)，防止意外局域网暴露
VERSO_HOST=127.0.0.1
VERSO_PORT=4173

# 允许跨域或特定来源的逗号分隔列表（留空使用默认回环安全策略）
# VERSO_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# ------------------------------------------------------------------------------
# 3. AI 模型服务端配置 (OpenAI 兼容协议单端点)
# ------------------------------------------------------------------------------
# Verso 服务端统一通过 OpenAI 兼容接口调用大语言模型。
# 请在下方填写您的 API Key，并根据您使用的服务商取消注释或修改相应参数。

# === 常用服务商模板 A：DeepSeek (高性价比严肃文学审读推荐) ===
# VERSO_OPENAI_BASE_URL=https://api.deepseek.com/v1
# VERSO_OPENAI_API_KEY=sk-your-deepseek-key-here
# VERSO_REASONING_MODEL=deepseek-chat
# VERSO_FAST_MODEL=deepseek-chat
# VERSO_MEDIA_MODEL=deepseek-chat
# VERSO_EMBEDDING_MODEL=text-embedding-3-small

# === 常用服务商模板 B：OpenAI 官方 ===
VERSO_OPENAI_BASE_URL=https://api.openai.com/v1
VERSO_OPENAI_API_KEY=
VERSO_REASONING_MODEL=gpt-4o
VERSO_FAST_MODEL=gpt-4o-mini
VERSO_MEDIA_MODEL=gpt-4o
VERSO_EMBEDDING_MODEL=text-embedding-3-small

# === 常用服务商模板 C：OpenRouter (聚合网关，可使用 Claude 3.7 Sonnet 等) ===
# VERSO_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# VERSO_OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
# VERSO_REASONING_MODEL=anthropic/claude-3.7-sonnet
# VERSO_FAST_MODEL=openai/gpt-4o-mini
# VERSO_MEDIA_MODEL=openai/gpt-4o
# VERSO_EMBEDDING_MODEL=openai/text-embedding-3-small

# === 常用服务商模板 D：本地 Ollama (完全离线，提示词与文本不离机) ===
# VERSO_OPENAI_BASE_URL=http://localhost:11434/v1
# VERSO_OPENAI_API_KEY=ollama
# VERSO_REASONING_MODEL=qwen2.5:32b
# VERSO_FAST_MODEL=qwen2.5:7b
# VERSO_MEDIA_MODEL=qwen2.5:32b
# VERSO_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 4. 默认语言与界面设置
# ------------------------------------------------------------------------------
# 可选值: zh-CN, en-US
VERSO_DEFAULT_LOCALE=zh-CN

# ------------------------------------------------------------------------------
# 5. 上下文预算与资源安全限制
# ------------------------------------------------------------------------------
# 单次审读/Agent 上下文 Token 预算（超出将由上下文引擎依据谱系权重裁剪）
VERSO_CONTEXT_BUDGET=128000

# 模型单次响应最大生成 Token 数
VERSO_MAX_OUTPUT_TOKENS=4096

# 单次模型请求超时时间 (毫秒，默认 60000ms = 60秒；长篇深度审读可调至 180000)
VERSO_REQUEST_TIMEOUT_MS=60000

# 媒体/素材单文件最大上传限制 (字节，默认 100MB)
VERSO_MAX_UPLOAD_BYTES=104857600
